// backup of DisguiseRepository.java
package com.knowplugins.nardodev.kaoscore.managers.plugin;

import com.knowplugins.ysubz.kaoscore.KaosCore;
import org.bukkit.Bukkit;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.UUID;
import java.util.concurrent.CompletableFuture;

public class DisguiseRepository {

    private final KnowPractice plugin;
    private final DatabaseManager databaseManager;

    public DisguiseRepository(KnowPractice plugin, DatabaseManager databaseManager) {
        this.plugin = plugin;
        this.databaseManager = databaseManager;
    }

    public CompletableFuture<String> load(UUID uuid) {
        return CompletableFuture.supplyAsync(() -> {
            Connection conn = null;
            try {
                conn = databaseManager.getConnection();
                if (conn == null || conn.isClosed()) {
                    plugin.getLogger().warning("DB connection was closed, attempting reconnect...");
                    databaseManager.connect();
                    conn = databaseManager.getConnection();
                    if (conn == null || conn.isClosed()) {
                        plugin.getLogger().warning("Failed to obtain DB connection for disguise load");
                        return null;
                    }
                }

                try (PreparedStatement ps = conn.prepareStatement("SELECT is_disguised, disguise_meta FROM disguises WHERE uuid = ?")) {
                    ps.setString(1, uuid.toString());
                    try (ResultSet rs = ps.executeQuery()) {
                        if (rs.next()) {
                            boolean isDisguised = rs.getBoolean("is_disguised");
                            if (isDisguised) {
                                return rs.getString("disguise_meta");
                            }
                        }
                    }
                }
            } catch (Exception e) {
                plugin.getLogger().warning("Erro ao carregar disguise do DB: " + e.getMessage());
                e.printStackTrace();
            } finally {
                try {
                    if (conn != null && !conn.isClosed()) conn.close();
                } catch (Exception ignored) {}
            }
            return null;
        });
    }

    public void saveAsync(UUID uuid, boolean isDisguised, String type, String meta) {
        Bukkit.getScheduler().runTaskAsynchronously(plugin, () -> {
            try (Connection conn = databaseManager.getConnection()) {
                try (PreparedStatement ps = conn.prepareStatement("REPLACE INTO disguises (uuid,is_disguised,disguise_type,disguise_meta) VALUES (?,?,?,?)")) {
                    ps.setString(1, uuid.toString());
                    ps.setBoolean(2, isDisguised);
                    ps.setString(3, type);
                    ps.setString(4, meta);
                    ps.executeUpdate();
                }
            } catch (Exception e) {
                plugin.getLogger().warning("Erro ao salvar disguise no DB: " + e.getMessage());
                e.printStackTrace();
            }
        });
    }
}

